<Window x:Class="InstantFileSearch.ExclusionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excluded folders"
        Height="380" Width="560"
        MinHeight="260" MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="These folders are skipped on every scan. Remove one, then Scan again to bring it back."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Remove selected" Style="{StaticResource ToolbarButton}" Command="{Binding RemoveExclusionCommand}"/>
            <Button Content="Close" Style="{StaticResource ToolbarButton}" Click="Close_Click" Margin="0"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding ExclusionPaths}"
                 SelectedItem="{Binding SelectedExclusion}"
                 DisplayMemberPath="."/>
    </DockPanel>
</Window>
