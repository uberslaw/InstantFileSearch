<Window x:Class="InstantFileSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant File Search"
        Height="760" Width="1200"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open folder…" Command="{Binding BrowseCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Scan" Command="{Binding ScanCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Scan">
                <MenuItem Header="_Cancel" Command="{Binding CancelCommand}" InputGestureText="Esc"/>
                <Separator/>
                <MenuItem Header="Exclude selected folder" Command="{Binding ExcludeFolderCommand}"/>
                <MenuItem Header="Remove from list" Command="{Binding RemoveScanCommand}"
                          ToolTip="Removes the selected scan from the list. Does not delete files on disk."/>
                <MenuItem Header="Excluded folders…" Command="{Binding ShowExclusionsCommand}"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding LastScanText}" Opacity="0.9"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgressPath}" TextTrimming="CharacterEllipsis" MaxWidth="420" Opacity="0.8"/>
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBgBrush}"
                Padding="12,10"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Margin="0,0,10,0"
                             Tag="Folder to scan"
                             Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Folder to scan. Drop a folder on the window to fill this."/>
                    <Button Grid.Column="1"
                            Content="Browse"
                            Style="{StaticResource ToolbarButton}"
                            Command="{Binding BrowseCommand}"
                            ToolTip="Choose a folder (Ctrl+O)"/>
                    <Button Grid.Column="2"
                            Content="Scan"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding ScanCommand}"
                            ToolTip="Scan this folder (F5). Same path replaces that tree root."/>
                    <Button Grid.Column="3"
                            Content="Cancel"
                            Style="{StaticResource CancelButton}"
                            Command="{Binding CancelCommand}"
                            Margin="0"
                            ToolTip="Stop the scan (Esc)"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Tag="Search files and folders  ·  * and ? for partial names"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Exact name match (including extension). Use * and ? for partial names. Ctrl+F or F3 to focus. Empty text is allowed with Advanced filters."/>
                    <ToggleButton Grid.Column="1"
                                  Content="Advanced"
                                  Margin="8,0,0,0"
                                  IsChecked="{Binding IsAdvancedOpen}"
                                  Style="{StaticResource ToolbarToggle}"
                                  ToolTip="Size, date, folder scope, and name vs path. Not saved."/>
                </Grid>
                <WrapPanel Margin="0,8,0,-8" Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource FilterGroup}">
                        <StackPanel>
                            <TextBlock Text="SIZE" Style="{StaticResource FilterCaption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="72"
                                         Tag="From"
                                         Text="{Binding SizeFromText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Minimum size. Empty means no minimum. Units are 1024-based (1 KB = 1024 bytes)."/>
                                <ComboBox Width="68"
                                          Margin="6,0,0,0"
                                          ItemsSource="{Binding SizeUnitOptions}"
                                          SelectedItem="{Binding SizeFromUnit}"/>
                                <TextBlock Text="–"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Width="72"
                                         Tag="To"
                                         Text="{Binding SizeToText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Maximum size. Empty means no maximum."/>
                                <ComboBox Width="68"
                                          Margin="6,0,0,0"
                                          ItemsSource="{Binding SizeUnitOptions}"
                                          SelectedItem="{Binding SizeToUnit}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterGroup}">
                        <StackPanel>
                            <TextBlock Text="MODIFIED" Style="{StaticResource FilterCaption}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="118"
                                         Tag="yyyy-MM-dd"
                                         Text="{Binding ModifiedFromText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Earliest last-write date (yyyy-MM-dd). Empty means no minimum."/>
                                <TextBlock Text="–"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBox Width="118"
                                         Tag="yyyy-MM-dd"
                                         Text="{Binding ModifiedToText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Latest last-write date (yyyy-MM-dd). Empty means no maximum."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterGroup}">
                        <StackPanel>
                            <TextBlock Text="SCOPE" Style="{StaticResource FilterCaption}"/>
                            <ComboBox MinWidth="148"
                                      ItemsSource="{Binding ScopeOptions}"
                                      SelectedItem="{Binding SearchScope}"
                                      ToolTip="All scans searches every loaded location. Selected folder limits to the tree node."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FilterGroup}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="MATCH" Style="{StaticResource FilterCaption}"/>
                            <ComboBox MinWidth="148"
                                      ItemsSource="{Binding MatchModeOptions}"
                                      SelectedItem="{Binding MatchMode}"
                                      ToolTip="Without * or ?, Name equals the whole file or folder name (including extension). Path equals the whole path. Name or path tries both. Use *\cmd or *cmd* for partial paths."/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="12,8,8,4">
                    <ComboBox DockPanel.Dock="Right"
                              MinWidth="92"
                              Width="92"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding TreeSortOptions}"
                              SelectedItem="{Binding TreeSortChoice}"
                              ToolTip="Sort scan roots and folder children. FILES sorts with siblings (name FILES, or its direct-file size). Saved for the next launch."/>
                    <TextBlock Style="{StaticResource PanelCaption}"
                               Margin="0"
                               VerticalAlignment="Center"
                               Text="FOLDERS"/>
                </DockPanel>
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding TreeRoots}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Standard">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" CommandParameter="tree"/>
                            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}" CommandParameter="tree"/>
                            <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" CommandParameter="tree"/>
                            <Separator/>
                            <MenuItem Header="Exclude folder" Command="{Binding ExcludeFolderCommand}" CommandParameter="tree"/>
                            <MenuItem Header="Remove from list"
                                      Command="{Binding RemoveScanCommand}"
                                      ToolTip="Removes this scan from the list. Does not delete files on disk.">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding TreeChildren}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="{Binding Glyph}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="14"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" Height="8" Margin="4,0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BarTrackBrush}" CornerRadius="2"/>
                                    <Border HorizontalAlignment="Left" Background="{StaticResource BarFillBrush}" CornerRadius="2">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                <Binding Path="PercentOfParent"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding PercentText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding DurationText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="5"
                                           Text="{Binding Size, Converter={StaticResource ByteSize}}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource ToolbarBgBrush}"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource PanelCaption}"
                           Text="{Binding ContentsHeaderText}"/>
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource ToolbarBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8"
                        Visibility="{Binding HasSelectionDetails, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding SelectedDetailsMeta}"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedDetailsPath}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding SelectedDetailsPath}"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <DataGrid x:Name="EntryGrid"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedEntry}"
                              MouseDoubleClick="EntryGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                                <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}"/>
                                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"/>
                                <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}"/>
                                <Separator/>
                                <MenuItem Header="Exclude folder" Command="{Binding ExcludeFolderCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="32" CanUserSort="True" SortMemberPath="IsFolder">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="{Binding Glyph}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource FileGlyphBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" SortMemberPath="Kind" Width="72"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" SortMemberPath="FullPath" Width="3*"/>
                            <DataGridTemplateColumn Header="Size" Width="150" SortMemberPath="Size">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BarTrackBrush}" CornerRadius="2"/>
                                                <Border HorizontalAlignment="Left" Background="{StaticResource BarFillBrush}" CornerRadius="2">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                            <Binding Path="Percent"/>
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SizeText}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PercentText}"
                                                       Margin="8,0,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="132"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding EmptyStateText}"
                               Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
