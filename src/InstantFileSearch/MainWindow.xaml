<Window x:Class="InstantFileSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InstantFileSearch"
        Title="Instant File Search"
        Height="760" Width="1200"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open folder…" Command="{Binding BrowseCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Scan" Command="{Binding ScanCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Scan">
                <MenuItem Header="_Cancel" Command="{Binding CancelCommand}" InputGestureText="Esc"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgressPath}" TextTrimming="CharacterEllipsis" MaxWidth="420" Opacity="0.8"/>
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Top" Background="#16181C" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="SearchBox"
                             Width="280"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter scanned files. Wildcards * and ? work."/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Margin="0,0,10,0"
                             Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Folder to scan"/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource ToolbarButton}" Command="{Binding BrowseCommand}"/>
                    <Button Grid.Column="2" Content="Scan" Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}"/>
                    <Button Grid.Column="3" Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Margin="0"/>
                </Grid>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,10,12,6"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Text="FOLDERS (largest first)"/>
                <TreeView x:Name="FolderTree"
                          ItemsSource="{Binding TreeRoots}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Folders}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE8B7;"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="14"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" Height="8" Margin="6,0" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BarTrackBrush}" CornerRadius="2"/>
                                    <Border HorizontalAlignment="Left" Background="{StaticResource BarFillBrush}" CornerRadius="2">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                <Binding Path="PercentOfParent"/>
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Size, Converter={StaticResource ByteSize}}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#16181C"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Margin="12,10,12,6"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Text="CONTENTS"/>
                <DataGrid x:Name="EntryGrid"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedEntry}"
                          MouseDoubleClick="EntryGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding OpenCommand}"/>
                            <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}"/>
                            <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="32">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="{Binding Glyph}"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTemplateColumn Header="Size" Width="160" SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border Background="{StaticResource BarTrackBrush}" CornerRadius="2"/>
                                            <Border HorizontalAlignment="Left" Background="{StaticResource BarFillBrush}" CornerRadius="2">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                        <Binding Path="Percent"/>
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="140"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
