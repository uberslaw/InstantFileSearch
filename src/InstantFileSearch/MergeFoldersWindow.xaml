<Window x:Class="InstantFileSearch.MergeFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge / Move"
        Height="560" Width="640"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Plan from the scan index — IFS does not ask Explorer to prepare the tree. Same-volume files are renamed; collisions default to skip."/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Merge" Style="{StaticResource AccentButton}" Click="Merge_Click" IsDefault="True"/>
                <Button Content="Cancel" Style="{StaticResource ToolbarButton}" Click="Cancel_Click" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="Source" Width="72" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="SourceBox"
                         TextChanged="Path_TextChanged"
                         ToolTip="Folder to merge from. Must already be in the left-hand scan tree."/>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="Dest" Width="72" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="DestBox"
                         TextChanged="Path_TextChanged"
                         ToolTip="Folder to merge into. Paste a path under a loaded scan, or pick from the list."/>
            </DockPanel>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource PanelCaption}"
                           Margin="0,0,0,4"
                           Text="FOLDERS IN THE INDEX"/>
                <ListBox x:Name="FolderList"
                         MouseDoubleClick="FolderList_MouseDoubleClick"
                         SelectionChanged="FolderList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FullPath}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="If the destination already has the file" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <RadioButton x:Name="SkipRadio"
                             Content="Skip existing (default)"
                             IsChecked="True"
                             Checked="Policy_Changed"/>
                <RadioButton x:Name="OverwriteRadio"
                             Content="Overwrite"
                             Margin="0,4,0,0"
                             Checked="Policy_Changed"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
