<Window x:Class="InstantFileSearch.ScanHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding HistoryWindowTitle}"
        Height="480" Width="780"
        MinHeight="320" MinWidth="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="{Binding HistoryWindowIntro}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left"
                       Text="Find"
                       Width="40"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBox Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding HistoryFilterPlaceholder}"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Load"
                    Style="{StaticResource AccentButton}"
                    Command="{Binding LoadHistoryCommand}"
                    ToolTip="Puts this snapshot in the left tree. The label includes the scan date."/>
            <Button Content="Delete"
                    Style="{StaticResource ToolbarButton}"
                    Command="{Binding DeleteHistoryCommand}"
                    ToolTip="Removes this snapshot from the cache. Does not delete files on disk."/>
            <Button Content="Close" Style="{StaticResource ToolbarButton}" Click="Close_Click" Margin="0" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <DataGrid ItemsSource="{Binding HistoryEntries}"
                      SelectedItem="{Binding SelectedHistoryEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      SelectionMode="Single"
                      MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path=Path}" Width="2*"/>
                    <DataGridTextColumn Header="Where" Binding="{Binding LocationText}" Width="80"/>
                    <DataGridTextColumn Header="Scanned" Binding="{Binding CompletedLocalText}" Width="132"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80"/>
                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="72"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="88"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding HistoryEmptyText}"
                       Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
