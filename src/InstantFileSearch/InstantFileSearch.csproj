<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>InstantFileSearch</RootNamespace>
    <AssemblyName>InstantFileSearch</AssemblyName>
    <Product>Instant File Search</Product>
    <Description>TreeSize-style folder size tree and instant file search for Windows.</Description>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstantFileSearch.Core\InstantFileSearch.Core.csproj" />
  </ItemGroup>

</Project>
